# Copy this file to apps/web/.env.local and fill in real values.
# NEVER commit .env.local — it is git-ignored.
# Set the same variables in Vercel → Project → Settings → Environment Variables.

# --- Supabase (London region project) ---
# Public: safe to expose to the browser (RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only: bypasses RLS. Never prefix with NEXT_PUBLIC_, never use in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- LLM extraction (Deal X-ray) — not wired yet ---
# LLM_API_KEY=

# --- Duffel (future: live flight prices) — not wired yet ---
# DUFFEL_ACCESS_TOKEN=
