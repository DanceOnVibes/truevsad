# Copy this file to apps/web/.env.local and fill in real values.
# NEVER commit .env.local — it is git-ignored.
# Set the same variables in Vercel → Project → Settings → Environment Variables.

# --- Supabase (London region project) ---
# Public: safe to expose to the browser (RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only: bypasses RLS. Never prefix with NEXT_PUBLIC_, never use in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Deal X-ray AI reader: Gemini on Google Cloud Agent Platform (London) ---
# Server only. Without these, the X-ray falls back to "type the details yourself".
GOOGLE_CLOUD_PROJECT=truevsad
GOOGLE_CLOUD_LOCATION=europe-west2
# The whole service-account key JSON on one line. Mark as Sensitive in Vercel. Never commit it.
GCP_SERVICE_ACCOUNT_KEY=
# Optional: override model order, newest first, e.g. gemini-3.5-flash,gemini-2.5-flash
# GEMINI_MODELS=

# --- Duffel (future: live flight prices) — not wired yet ---
# DUFFEL_ACCESS_TOKEN=
